// regression: values live across calls (-O3). a call overwrites every caller-saved register, so an
// integer that must survive one goes to a callee-saved register (rbx, r12-r15, saved in the prologue)
// or the stack, and a double always goes to the stack (system v keeps no xmm register across a
// call). calls inside loops, nested calls in arguments, and a recursive call with values around it

//recursive, so inlining leaves the calls in place
int bump(int x) {
    if (x > 1000000) return bump(x - 1000000);
    return x + 1;
}

double half(double x) {
    if (x > 1000000.0) return half(x - 1000000.0);
    return x * 0.5;
}

int sumAcrossCalls(int n) {
    int total = 0;
    int extra = 7;
    for (int i = 0; i < n; i++) {
        int before = total;
        total = bump(total) + i;
        extra = extra + before % 3;
    }
    return total * 1000 + extra;
}

double floatsAcrossCalls(int n) {
    double acc = 1.0;
    double keep = 3.25;
    for (int i = 0; i < n; i++) {
        double previous = acc;
        acc = half(acc) + keep;
        keep = keep + previous * 0.125;
    }
    return acc + keep;
}

int depth(int n, int a, int b) {
    if (n == 0) return a - b;
    int left = a * 3 + n;
    int right = b * 5 - n;
    int inner = depth(n - 1, right, left);
    return left - right + inner;
}

int nested(int x) { return bump(bump(x) * bump(x + 1)) + bump(x * 2); }

int main() {
    printf("ints %d %d\n", sumAcrossCalls(0), sumAcrossCalls(25));
    printf("floats %.6f %.6f\n", floatsAcrossCalls(0), floatsAcrossCalls(12));
    printf("depth %d %d\n", depth(0, 4, 9), depth(6, 4, 9));
    printf("nested %d\n", nested(5));
    return 0;
}

// -O3: the integers that survive the call in the loop live in callee-saved registers
// ASM-O3-LABEL: global_14sumAcrossCalls_i:
// ASM-O3: movq %{{(rbx|r12|r13|r14|r15)}}, -{{[0-9]+}}(%rbp)
// ASM-O3-LABEL: global_17floatsAcrossCalls_i:
// the doubles cannot stay in a register across the call: spilled
// ASM-O3-NEXT: # graph colouring: {{[0-9]+}} virtual registers, {{[0-9]+}} copies coalesced, {{[1-9][0-9]*}} spilled
// ASM-O3-LABEL: main:
