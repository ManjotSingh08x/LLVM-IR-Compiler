// regression: graph colouring under pressure (-O3). twenty integers and twenty doubles are all live
// at once, more than the 14 general and 16 xmm registers, so some must be spilled and reloaded; the
// sums check that every value survives. the seeds come from stdin (test/regression/inputs): 3 7

int manyInts(int s, int t) {
    int a0 = s + 1;   int a1 = t * 2;   int a2 = s * t;   int a3 = s - t;   int a4 = s + 7;
    int a5 = t + 11;  int a6 = s * 3;   int a7 = t - 5;   int a8 = s + t;   int a9 = s * 13;
    int b0 = t * 17;  int b1 = s - 19;  int b2 = t + 23;  int b3 = s * 29;  int b4 = t - 31;
    int b5 = s + 37;  int b6 = t * 41;  int b7 = s - 43;  int b8 = t + 47;  int b9 = s * 53;
    //every value is read again after all of them exist
    int x = a0 * 1 + a1 * 2 + a2 * 3 + a3 * 4 + a4 * 5 + a5 * 6 + a6 * 7 + a7 * 8 + a8 * 9 + a9 * 10;
    int y = b0 * 11 + b1 * 12 + b2 * 13 + b3 * 14 + b4 * 15 + b5 * 16 + b6 * 17 + b7 * 18 + b8 * 19 + b9 * 20;
    return x - y + a0 * b9 - a9 * b0;
}

double manyDoubles(double s, double t) {
    double a0 = s + 1.5;  double a1 = t * 2.5;  double a2 = s * t;    double a3 = s - t;    double a4 = s + 7.25;
    double a5 = t + 11.0; double a6 = s * 3.0;  double a7 = t - 5.5;  double a8 = s + t;    double a9 = s * 0.5;
    double b0 = t * 1.75; double b1 = s - 9.0;  double b2 = t + 2.0;  double b3 = s * 2.25; double b4 = t - 3.0;
    double b5 = s + 4.0;  double b6 = t * 0.25; double b7 = s - 6.5;  double b8 = t + 8.0;  double b9 = s * 1.25;
    double x = a0 + a1 * 2.0 + a2 * 3.0 + a3 * 4.0 + a4 * 5.0 + a5 * 6.0 + a6 * 7.0 + a7 * 8.0 + a8 * 9.0 + a9 * 10.0;
    double y = b0 + b1 * 2.0 + b2 * 3.0 + b3 * 4.0 + b4 * 5.0 + b5 * 6.0 + b6 * 7.0 + b7 * 8.0 + b8 * 9.0 + b9 * 10.0;
    return x - y + a0 * b9 - a9 * b0;
}

int loopPressure(int n, int s) {
    int a = s;
    int b = s + 1;
    int c = s + 2;
    int d = s + 3;
    int e = s + 4;
    int f = s + 5;
    int g = s + 6;
    int h = s + 7;
    int i2 = s + 8;
    int j = s + 9;
    int k = s + 10;
    int l = s + 11;
    int m = s + 12;
    int o = s + 13;
    int p = s + 14;
    int q = s + 15;
    for (int i = 0; i < n; i++) {
        //a rotation of sixteen loop-carried values: all live around the back edge
        int t = a;
        a = b; b = c; c = d; d = e; e = f; f = g; g = h; h = i2;
        i2 = j; j = k; k = l; l = m; m = o; o = p; p = q; q = t + i;
    }
    return a + b * 2 + c * 3 + d * 4 + e * 5 + f * 6 + g * 7 + h * 8 + i2 * 9 + j * 10 + k * 11 + l * 12 + m * 13 +
           o * 14 + p * 15 + q * 16;
}

int main() {
    int s;
    int t;
    scanf("%d %d", &s, &t);
    printf("ints %d %d\n", manyInts(s, t), manyInts(t, s));
    printf("doubles %.4f %.4f\n", manyDoubles(s, t), manyDoubles(t * 0.5, s * 1.5));
    printf("loop %d %d %d\n", loopPressure(0, s), loopPressure(5, s), loopPressure(40, t));
    return 0;
}

// -O3: more values live at once than registers: the loop rotation must spill something
// ASM-O3-LABEL: global_12loopPressure_ii:
// ASM-O3-NEXT: # graph colouring: {{[0-9]+}} virtual registers, {{[0-9]+}} copies coalesced, {{[1-9][0-9]*}} spilled
