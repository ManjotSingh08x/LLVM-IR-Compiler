// regression: unreachable code and jumps to jumps. code after return, break, continue and goto,
// empty blocks that only jump on, and blocks merged into their only predecessor

int classify(int x) {
    if (x < 0) {
        return -1;
    } else {
        if (x == 0) return 0;
    }
    return 1;
}

int firstMultiple(int step, int limit) {
    int found = -1;
    for (int i = 1; i < limit; i++) {
        if (i % step != 0) continue;
        found = i;
        break;
    }
    return found;
}

int skipWithGoto(int x) {
    int y = x;
    if (x > 10) goto done;
    y = y * 2;
    if (y > 10) goto done;
    y = y + 100;
done:
    return y;
}

int nested(int a, int b) {
    int r = 0;
    if (a > 0) {
        if (b > 0) {
            r = 1;
        } else {
            r = 2;
        }
    } else {
        if (b > 0) {
            r = 3;
        }
    }
    return r;
}

int main() {
    printf("classify %d %d %d\n", classify(-5), classify(0), classify(9));
    printf("multiple %d %d\n", firstMultiple(7, 50), firstMultiple(70, 50));
    printf("goto %d %d %d\n", skipWithGoto(20), skipWithGoto(8), skipWithGoto(3));
    printf("nested %d %d %d %d\n", nested(1, 1), nested(1, -1), nested(-1, 1), nested(-1, -1));
    return 0;
}

// the "continue" block held only "br label %for.inc": it is bypassed, so the test jumps there directly
// IR-LABEL: define {{.*}}firstMultiple
// IR: br i1 {{%[A-Za-z0-9_.]+}}, label %for.inc{{[.0-9]*}}, label
// IR-LABEL: define {{.*}}skipWithGoto
