// Every declaration here parses. Each marked line is a type error.
struct Point {
    int x;
    int y;
};

int takesInt(int a) {
    return a;
}

int main() {
    // Tests: use of an undeclared name
    int a = undeclaredName;

    // Tests: a name used before it is declared
    int b = later;
    int later = 1;

    // Tests: redefinition in the same scope
    int twice = 1;
    int twice = 2;

    // Tests: incompatible initialisation
    Point p;
    int fromStruct = p;

    // Tests: assigning to something that is not a variable
    7 = a;
    takesInt(1) = a;

    // Tests: dereferencing and indexing a non-pointer
    int plain = 5;
    int bad = *plain;
    int worse = plain[0];

    // Tests: taking the address of a value
    int *addr = &42;

    // Tests: a struct used where a number is needed
    int sum = p + 1;
    int cond = p ? 1 : 2;

    // Tests: bitwise and remainder operators need integers
    double d = 1.5;
    int mask = d & 1;
    int rem = d % 2;

    // Tests: a member that does not exist, and member access on a non-class
    int missing = p.z;
    int notClass = plain.x;

    // Tests: '.' where '->' is needed, and the reverse
    Point *pp = &p;
    int viaDot = pp.x;
    int viaArrow = p->x;

    // Tests: an array needs a brace list, and too many initializers
    int arr[2] = 5;
    int full[2] = {1, 2, 3};
    Point xy = {1, 2, 3};

    // Tests: an array size must be a positive constant
    int sized[plain];
    int negative[-1];

    // Tests: void and auto misuse
    auto noInit;

    // Tests: delete on something that is not a pointer
    delete plain;

    // Tests: this outside a member function
    return this->x;
}
