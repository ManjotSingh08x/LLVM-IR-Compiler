// regression: leaving ssa in codegen. the swap problem (a, b = b, a in a loop gives phis that read
// each other), a three-way rotation, the lost-copy problem (the old value of a loop variable used
// after the loop), a switch with several cases into one block (one phi entry per edge), and phis
// of every width: bool, char, int, double, float and pointer

int swapLoop(int n) {
    int a = 1;
    int b = 2;
    for (int i = 0; i < n; i++) {
        int t = a;
        a = b;
        b = t;
    }
    return a * 10 + b;
}

int rotate3(int n) {
    int a = 1;
    int b = 2;
    int c = 3;
    for (int i = 0; i < n; i++) {
        int t = a;
        a = b;
        b = c;
        c = t;
    }
    return a * 100 + b * 10 + c;
}

int lostCopy(int n) {
    int x = 0;
    int previous = -1;
    while (x < n) {
        previous = x;
        x = x + 3;
    }
    return previous * 1000 + x;
}

int sharedTarget(int k) {
    int v = 100;
    switch (k) {
    case 1:
    case 2:
    case 3:
        v = v + k;
        break;
    case 4:
        v = 0;
        break;
    }
    return v;
}

double widths(int n) {
    bool flag = false;
    char letter = 'a';
    int count = 0;
    double total = 0.5;
    float scale = 1.0;
    int data[3] = {7, 8, 9};
    int *cursor = &data[0];
    for (int i = 0; i < n; i++) {
        flag = !flag;
        letter = letter + 1;
        count += *cursor;
        total = total * 1.5;
        scale = scale / 2.0;
        cursor = cursor + 1;
        if (i % 3 == 2) cursor = &data[0];
    }
    double extra = flag ? 1000.0 : 0.0;
    return extra + letter + count + total + scale;
}

int main() {
    printf("swap %d %d %d\n", swapLoop(0), swapLoop(1), swapLoop(4));
    printf("rotate %d %d %d\n", rotate3(0), rotate3(1), rotate3(5));
    printf("lost %d %d\n", lostCopy(0), lostCopy(10));
    printf("shared %d %d %d %d %d\n", sharedTarget(1), sharedTarget(2), sharedTarget(3), sharedTarget(4), sharedTarget(9));
    printf("widths %.4f %.4f\n", widths(0), widths(7));
    return 0;
}

// -O2 and up: the swaps and rotations are phis that read each other
// IR-LABEL: define i32 @{{[A-Za-z0-9_]*}}swapLoop
// IR-GE2: phi i32
// IR-GE2: phi i32
