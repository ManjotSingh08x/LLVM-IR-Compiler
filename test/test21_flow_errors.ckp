// Statements and control flow. Every line marked is a semantic error.
struct Point {
    int x;
};

int main() {
    int i = 0;
    Point p;

    // Tests: break and continue outside a loop or switch
    break;
    continue;

    // Tests: a goto to a label that does not exist
    goto nowhere;

    // Tests: a label and a goto that do match
    goto here;
here:
    i++;

    // Tests: a duplicate label in one function
here:
    i++;

    // Tests: a switch needs an integer condition
    switch (p) {
        case 1:
            break;
    }

    double d = 1.5;
    switch (d) {
        case 1:
            break;
    }

    // Tests: case values must be integer constants, and must not repeat
    switch (i) {
        case 1:
            break;
        case 1:
            break;
        case i:
            break;
        case 2 + 3:
            break;
        default:
            break;
        default:
            break;
    }

    // Tests: case and default outside a switch
    case 7:
        i++;
    default:
        i++;

    // Tests: a condition must be a scalar, a struct is not
    if (p) {
        i++;
    }
    while (p) {
        i++;
    }
    for (int j = 0; p; j++) {
        i++;
    }

    // Tests: a pointer is a valid condition
    int *ptr = &i;
    if (ptr) {
        i++;
    }

    // Tests: a loop variable is out of scope after its loop
    for (int k = 0; k < 3; k++) {
        i += k;
    }
    i = k;

    return i;
}
