// regression: harder inlining cases. a callee with a static local (its state must be shared by all
// inlined copies), a callee with a loop and several returns, a void callee that returns early, a
// chain a -> b -> c inlined bottom-up, a callee writing the caller's locals through pointers,
// arguments with side effects (evaluated exactly once), an inlined call in a loop condition, and a
// callee that calls something that is not inlined

int sideCount = 0;

int next() {
    sideCount++;
    return sideCount;
}

int counter() {
    static int n = 0;
    n++;
    return n;
}

int firstDivisor(int v) {
    for (int d = 2; d * d <= v; d++) {
        if (v % d == 0) return d;
    }
    return v;
}

void clampInto(int *slot, int limit) {
    if (*slot <= limit) return;
    *slot = limit;
}

int c3(int x) { return x + 3; }
int b2(int x) { return c3(x) * 2; }
int a1(int x) { return b2(x) - 1; }

void swapThrough(int *x, int *y) {
    int t = *x;
    *x = *y;
    *y = t;
}

int twiceArg(int v) { return v + v; }

bool below(int v, int limit) { return v < limit; }

int recursive(int n) {
    if (n == 0) return 0;
    return n + recursive(n - 1);
}

int usesRecursive(int n) { return recursive(n) * 2; }

int main() {
    int c1 = counter();
    int c2 = counter();
    int c3v = counter();
    printf("static %d %d %d\n", c1, c2, c3v);

    printf("divisor %d %d %d %d\n", firstDivisor(91), firstDivisor(97), firstDivisor(4), firstDivisor(1));

    int s = 50;
    clampInto(&s, 20);
    int t = 5;
    clampInto(&t, 20);
    printf("clamp %d %d\n", s, t);

    printf("chain %d %d\n", a1(0), a1(10));

    int x = 1;
    int y = 2;
    swapThrough(&x, &y);
    swapThrough(&x, &y);
    swapThrough(&x, &y);
    printf("swap %d %d\n", x, y);

    sideCount = 0;
    int d = twiceArg(next());
    printf("once %d count %d\n", d, sideCount);

    int i = 0;
    while (below(i, 7)) i += 2;
    printf("cond %d\n", i);

    printf("recursive %d\n", usesRecursive(10));
    return 0;
}

// -O1 and up: counter, firstDivisor, clampInto, the chain, swapThrough, twiceArg, next, below and
// usesRecursive are inlined into main; only recursive is still called
// IR-LABEL: define i32 @main
// IR-GE1: call i32 @{{[A-Za-z0-9_]*}}recursive
// IR-GE1-NOT: call {{.*}}@{{[A-Za-z0-9_]*}}{{(4next|counter|firstDivisor|clampInto|a1|b2|c3|swapThrough|twiceArg|below|usesRecursive)}}
