// Tests: typedef
typedef int Number;

// Tests: const global
const int SIZE = 3;

int add(int a, int b) { return a + b; }

int main() {
    // Tests: several declarators in one declaration
    int a = 1, b = 2, *pa = &a;

    // Tests: arrays and multi-dimensional arrays
    int list[SIZE] = {1, 2, 3};
    int grid[2][3] = {{1, 2, 3}, {4, 5, 6}};

    // Tests: reference
    int &ref = b;
    ref = 20;

    // Tests: brace and constructor-style initialisation
    Number n{5};
    Number m(6);

    // Tests: pointer to an array and array of pointers
    int (*row)[3] = &grid[1];
    int *ptrs[2] = {&a, &b};

    // Tests: function pointer
    int (*op)(int, int) = add;

    printf("%d %d %d %d %d %d %d\n", *pa, b, list[2], (*row)[0], *ptrs[1], n + m, op(a, b));
    return 0;
}
