// IR run test: expressions. Expected output: test/expected/test23_ir_expressions.out

int main() {
    // Tests: arithmetic, bitwise and shift operators
    int a = 17;
    int b = 5;
    printf("%d %d %d %d %d\n", a + b, a - b, a * b, a / b, a % b);
    printf("%d %d %d %d %d\n", a & b, a | b, a ^ b, a << 2, a >> 1);

    // Tests: relational and logical operators
    bool t = (a > b) && (b != 0);
    bool f = (a < b) || !(a == 17);
    printf("%d %d\n", t, f);

    // Tests: conditional operator
    int bigger = (a > b) ? a : b;
    printf("%d\n", bigger);

    // Tests: assignment and compound assignment
    int c = 10;
    c += 5;
    c -= 3;
    c *= 2;
    c /= 4;
    c %= 4;
    printf("%d\n", c);

    // Tests: prefix and postfix increment and decrement
    int i = 3;
    int post = i++;
    int pre = ++i;
    i--;
    --i;
    printf("%d %d %d\n", post, pre, i);

    // Tests: char, float and double values
    char letter = 'a';
    letter++;
    float half = 0.5;
    double sum = half + 1.25;
    printf("%c %f\n", letter, sum);
    return 0;
}
