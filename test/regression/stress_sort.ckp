// stress: sorting and searching. insertion sort, selection sort, recursive quicksort, binary
// search, merging two sorted arrays, a pseudo-random generator kept in a global. every result is
// folded into a checksum so any wrong value anywhere changes the output

int seed = 12345;

int nextRandom() {
    seed = (seed * 1103515 + 12345) % 2147483;
    if (seed < 0) seed = -seed;
    return seed;
}

void fillRandom(int a[], int n, int range) {
    for (int i = 0; i < n; i++) a[i] = nextRandom() % range;
}

void insertionSort(int a[], int n) {
    for (int i = 1; i < n; i++) {
        int key = a[i];
        int j = i - 1;
        while (j >= 0 && a[j] > key) {
            a[j + 1] = a[j];
            j--;
        }
        a[j + 1] = key;
    }
}

void selectionSort(int a[], int n) {
    for (int i = 0; i < n - 1; i++) {
        int best = i;
        for (int j = i + 1; j < n; j++) {
            if (a[j] < a[best]) best = j;
        }
        if (best != i) {
            int t = a[i];
            a[i] = a[best];
            a[best] = t;
        }
    }
}

void swap(int *x, int *y) {
    int t = *x;
    *x = *y;
    *y = t;
}

int partition(int a[], int lo, int hi) {
    int pivot = a[hi];
    int i = lo - 1;
    for (int j = lo; j < hi; j++) {
        if (a[j] <= pivot) {
            i++;
            swap(&a[i], &a[j]);
        }
    }
    swap(&a[i + 1], &a[hi]);
    return i + 1;
}

void quickSort(int a[], int lo, int hi) {
    if (lo < hi) {
        int p = partition(a, lo, hi);
        quickSort(a, lo, p - 1);
        quickSort(a, p + 1, hi);
    }
}

bool isSorted(int a[], int n) {
    for (int i = 1; i < n; i++) {
        if (a[i - 1] > a[i]) return false;
    }
    return true;
}

int binarySearch(int a[], int n, int target) {
    int lo = 0;
    int hi = n - 1;
    while (lo <= hi) {
        int mid = lo + (hi - lo) / 2;
        if (a[mid] == target) return mid;
        if (a[mid] < target) {
            lo = mid + 1;
        } else {
            hi = mid - 1;
        }
    }
    return -1;
}

int merge(int a[], int na, int b[], int nb, int out[]) {
    int i = 0;
    int j = 0;
    int k = 0;
    while (i < na && j < nb) {
        if (a[i] <= b[j]) {
            out[k++] = a[i++];
        } else {
            out[k++] = b[j++];
        }
    }
    while (i < na) out[k++] = a[i++];
    while (j < nb) out[k++] = b[j++];
    return k;
}

int checksum(int a[], int n) {
    int sum = 0;
    for (int i = 0; i < n; i++) sum = (sum * 31 + a[i] + i) % 1000000007;
    return sum;
}

int main() {
    int a[200];
    int b[150];
    int c[120];
    int merged[350];

    fillRandom(a, 200, 1000);
    fillRandom(b, 150, 50);
    fillRandom(c, 120, 100000);

    insertionSort(a, 200);
    selectionSort(b, 150);
    quickSort(c, 0, 119);
    printf("sorted %d %d %d\n", isSorted(a, 200), isSorted(b, 150), isSorted(c, 120));
    printf("sums %d %d %d\n", checksum(a, 200), checksum(b, 150), checksum(c, 120));
    printf("ends %d %d %d %d %d %d\n", a[0], a[199], b[0], b[149], c[0], c[119]);

    int found = 0;
    int missing = 0;
    for (int t = 0; t < 1000; t += 7) {
        if (binarySearch(a, 200, t) >= 0) {
            found++;
        } else {
            missing++;
        }
    }
    printf("search %d %d %d\n", found, missing, binarySearch(c, 120, c[57]) >= 0);

    int n = merge(a, 200, b, 150, merged);
    printf("merged %d %d %d\n", n, isSorted(merged, n), checksum(merged, n));
    return 0;
}
