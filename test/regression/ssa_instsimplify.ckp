// regression: instsimplify on ssa. constants reassociated through chains ((x + 1) + 2 -> x + 3),
// identities exposed only after mem2reg turns loads into values, phis whose entries all agree, and
// floating chains that must not be reassociated. the input (test/regression/inputs) is 5

int main() {
    int input;
    scanf("%d", &input);
    int x = input;  //a copy whose address is never taken, so it becomes an ssa value

    int a = x + 1;
    int b = a + 2;
    int c = b + 3;
    int m = x * 2;
    int n = m * 4;
    int o = (x | 1) | 2;

    int same;
    if (x > 2) {
        same = x;
    } else {
        same = x;
    }
    int zero = same - x;

    double d = x;
    double e = (d + 0.1) + 0.2;

    printf("chain %d %d %d %d %d %.17f\n", c, n, o, zero, same, e);
    return 0;
}

// -O2 and up: the chains collapse to one operation each, the phi of x and x is gone
// IR-LABEL: define i32 @main
// IR-GE2-DAG: add i32 %{{[A-Za-z0-9_.]+}}, 6
// IR-GE2-DAG: shl i32 %{{[A-Za-z0-9_.]+}}, 3
// IR-GE2-DAG: or i32 %{{[A-Za-z0-9_.]+}}, 3
// IR-GE2-DAG: fadd double %{{[A-Za-z0-9_.]+}}, 0x3FB999999999999A
// IR-GE2-NOT: phi
