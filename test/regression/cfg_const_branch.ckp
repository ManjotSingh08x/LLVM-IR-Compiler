// regression: simplify_cfg folds branches on constants. until(true), do..while(false),
// while(false), if(true)/if(false) and a switch on a constant all become plain jumps, and the
// code they skip is deleted. the output must not change

int deadCalls = 0;

void neverCalled() {
    deadCalls = deadCalls + 1;
    printf("this must never print\n");
}

int untilTrue() {
    int runs = 0;
    until (true) {
        runs++;
    }
    return runs;
}

int doOnce() {
    int runs = 0;
    do {
        runs++;
    } while (false);
    return runs;
}

int whileFalse() {
    int runs = 0;
    while (false) {
        runs++;
        neverCalled();
    }
    return runs;
}

int constantIf(int x) {
    if (true) {
        x = x + 1;
    } else {
        neverCalled();
    }
    if (false) neverCalled();
    return x;
}

int constantSwitch() {
    int picked = 0;
    switch (2) {
    case 1:
        picked = 10;
        neverCalled();
        break;
    case 2:
        picked = 20;
        break;
    default:
        picked = 30;
        neverCalled();
    }
    return picked;
}

int main() {
    printf("until %d do %d while %d\n", untilTrue(), doOnce(), whileFalse());
    printf("if %d switch %d dead %d\n", constantIf(4), constantSwitch(), deadCalls);
    return 0;
}

// every constant branch is folded at every level, so no call to neverCalled is left
// IR-NOT: br i1 true
// IR-NOT: br i1 false
// IR-NOT: switch i32 2
// IR-NOT: call void @{{[A-Za-z0-9_]*}}neverCalled
