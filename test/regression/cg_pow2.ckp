// division and remainder by powers of two (rounding toward zero), and shifts by constant counts
struct Rec { int a; int b; int c; };

int divs(int x) { return x / 2 + x / 4 * 10 + x / 1024 * 100 + x / 1073741824 * 1000; }
int rems(int x) { return x % 2 + x % 8 * 10 + x % 1024 * 100; }
int shifts(int x) { return (x << 1) + (x << 31) + (x >> 1) + (x >> 31) + (x >> 0) + (x << 0); }
char charDiv(char c) { return c / 4; }

int main() {
    int total = 0;
    for (int x = -1100; x <= 1100; x = x + 37) {
        printf("%d: %d %d %d %d %d\n", x, divs(x), rems(x), shifts(x), x / 16, x % 16);
        total = total + divs(x) + rems(x);
    }
    int big = 2147483647;
    int small = -2147483647 - 1;
    printf("limits %d %d %d %d\n", big / 2, small / 2, big % 1024, small % 1024);
    printf("limits shift %d %d\n", small >> 31, big >> 30);

    char cs[5];
    cs[0] = -128; cs[1] = -7; cs[2] = 0; cs[3] = 7; cs[4] = 127;
    for (int i = 0; i < 5; i++) printf("char %d %d\n", cs[i], charDiv(cs[i]));

    Rec recs[10];
    Rec *first = &recs[0];
    for (int i = 0; i < 10; i++) {
        Rec *p = &recs[i];
        printf("ptrdiff %d %d\n", p - first, first - p);
    }
    printf("total %d\n", total);
    return 0;
}

// constant powers of two never reach idiv, constant shift counts never go through %cl
// ASM-LABEL: global_4divs_i:
// ASM-NOT: idiv
// ASM: .size global_4divs_i
// ASM-LABEL: global_4rems_i:
// ASM-NOT: idiv
// ASM: .size global_4rems_i
// ASM-LABEL: global_6shifts_i:
// ASM-NOT: %cl
// ASM: .size global_6shifts_i
