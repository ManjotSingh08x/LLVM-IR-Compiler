// regression: loop_rotate. for and while loops get a guard in front and their test at the bottom;
// loops that run zero times, loops with break and continue, nested loops and do/until loops still
// behave. a condition with && (several blocks) or a call is not rotated

int sumTo(int n) {
    int total = 0;
    for (int i = 0; i < n; i++) total += i;
    return total;
}

int countDown(int n) {
    int steps = 0;
    while (n > 0) {
        n = n - 2;
        steps++;
    }
    return steps;
}

int breakContinue(int n) {
    int acc = 0;
    for (int i = 0; i < n; i++) {
        if (i % 3 == 0) continue;
        if (i > 20) break;
        acc += i;
    }
    return acc;
}

int nestedLoops(int n) {
    int count = 0;
    for (int i = 0; i < n; i++)
        for (int j = 0; j < i; j++) count += j;
    return count;
}

int doLoop(int n) {
    int runs = 0;
    do {
        runs++;
        n--;
    } while (n > 0);
    return runs;
}

int untilLoop(int n) {
    int runs = 0;
    until (n <= 0) {
        n = n - 3;
        runs++;
    }
    return runs;
}

int limit(int n) { return n * 2; }

int conditionWithCall(int n) {
    int i = 0;
    while (i < limit(n)) i++;
    return i;
}

int conditionWithAnd(int n, int cap) {
    int i = 0;
    while (i < n && i < cap) i++;
    return i;
}

int main() {
    printf("sum %d %d %d\n", sumTo(0), sumTo(1), sumTo(100));
    printf("down %d %d %d\n", countDown(0), countDown(-3), countDown(9));
    printf("break %d %d\n", breakContinue(0), breakContinue(50));
    printf("nested %d %d\n", nestedLoops(0), nestedLoops(6));
    printf("do %d %d until %d %d\n", doLoop(0), doLoop(5), untilLoop(0), untilLoop(10));
    printf("call %d and %d %d\n", conditionWithCall(4), conditionWithAnd(10, 3), conditionWithAnd(2, 9));
    return 0;
}

// rotated: the entry block ends in the guard and the loop jumps back from its bottom.
// at -O0 the canonical blocks stay (a preheader, the test as the loop's last block);
// from -O1 on simplify_cfg merges them
// IR-LABEL: define {{.*}}sumTo
// IR: br i1 {{%[A-Za-z0-9_.]+}}, label %for.body{{[.0-9a-z]*}}, label %for.end
// IR-O0: for.cond{{[.0-9]*}}:
// IR-O0-NEXT: load i32
// IR-O0: icmp slt
// IR-O0-NEXT: br i1 {{%[A-Za-z0-9_.]+}}, label %for.body{{[.0-9]*}}, label %for.end
// IR-GE1: br i1 {{%[A-Za-z0-9_.]+}}, label %for.body{{[.0-9]*}}, label %for.end
// IR-LABEL: define {{.*}}countDown
// IR: br i1 {{%[A-Za-z0-9_.]+}}, label %while.body{{[.0-9a-z]*}}, label %while.end
// IR: br i1 {{%[A-Za-z0-9_.]+}}, label %while.body{{[.0-9]*}}, label %while.end
// not rotated: the header with the call or the && stays first
// IR-LABEL: define {{.*}}conditionWithCall
// IR: br label %while.cond
// IR-EMPTY:
// IR-NEXT: while.cond{{[.0-9]*}}:
// IR-LABEL: define {{.*}}conditionWithAnd
// IR: br label %while.cond
// IR-LABEL: define {{.*}}main
