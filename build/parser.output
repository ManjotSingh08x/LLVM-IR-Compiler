Terminals which are not used

   TOK_SIZEOF
   TOK__KEYWORD_END
   TOK__OPERATOR_END
   TOK__PUNCTUATION_END


Grammar

    0 $accept: translation_unit $end

    1 translation_unit: /* empty */
    2                 | translation_unit external_item

    3 external_item: record_definition
    4              | class_definition
    5              | function_definition
    6              | function_declaration
    7              | qualified_special_member_definition
    8              | declaration
    9              | static_item
   10              | error TOK_SEMI

   11 static_item: TOK_STATIC function_definition
   12            | TOK_STATIC function_declaration
   13            | TOK_STATIC declaration

   14 qualified_special_member_definition: TOK_IDENTIFIER TOK_SCOPE TOK_IDENTIFIER TOK_LPAREN parameter_list_opt TOK_RPAREN compound_statement
   15                                    | TOK_IDENTIFIER TOK_SCOPE TOK_BITNOT TOK_IDENTIFIER TOK_LPAREN parameter_list_opt TOK_RPAREN compound_statement

   16 record_definition: TOK_STRUCT TOK_IDENTIFIER inheritance_opt TOK_LBRACE record_items_opt TOK_RBRACE TOK_SEMI

   17 record_items_opt: /* empty */
   18                 | record_items_opt member_item

   19 class_definition: TOK_CLASS TOK_IDENTIFIER inheritance_opt TOK_LBRACE class_items_opt TOK_RBRACE TOK_SEMI

   20 inheritance_opt: /* empty */
   21                | TOK_COLON base_list

   22 base_list: base_specifier
   23          | base_list TOK_COMMA base_specifier

   24 base_specifier: access_specifier TOK_IDENTIFIER
   25               | TOK_IDENTIFIER

   26 class_items_opt: /* empty */
   27                | class_items_opt class_item

   28 class_item: access_specifier TOK_COLON
   29           | member_item

   30 special_member_definition: TOK_IDENTIFIER TOK_LPAREN parameter_list_opt TOK_RPAREN compound_statement
   31                          | TOK_BITNOT TOK_IDENTIFIER TOK_LPAREN parameter_list_opt TOK_RPAREN compound_statement

   32 special_member_declaration: TOK_IDENTIFIER TOK_LPAREN parameter_list_opt TOK_RPAREN TOK_SEMI
   33                           | TOK_BITNOT TOK_IDENTIFIER TOK_LPAREN parameter_list_opt TOK_RPAREN TOK_SEMI

   34 access_specifier: TOK_PUBLIC
   35                 | TOK_PRIVATE
   36                 | TOK_PROTECTED

   37 member_item: record_definition
   38            | class_definition
   39            | function_definition
   40            | function_declaration
   41            | special_member_definition
   42            | special_member_declaration
   43            | declaration
   44            | static_item
   45            | error TOK_SEMI

   46 simple_type: TOK_INT
   47            | TOK_CHAR
   48            | TOK_FLOAT
   49            | TOK_DOUBLE
   50            | TOK_VOID
   51            | TOK_BOOL
   52            | TOK_AUTO

   53 type_specifier: simple_type
   54               | TOK_IDENTIFIER
   55               | TOK_STRUCT TOK_IDENTIFIER

   56 qualified_name: TOK_IDENTIFIER
   57               | qualified_name TOK_SCOPE TOK_IDENTIFIER

   58 function_definition: type_specifier qualified_name TOK_LPAREN parameter_list_opt TOK_RPAREN compound_statement

   59 function_declaration: type_specifier qualified_name TOK_LPAREN parameter_list_opt TOK_RPAREN TOK_SEMI

   60 parameter_list_opt: /* empty */
   61                   | parameter_list

   62 parameter_list: parameter_declaration
   63               | parameter_list TOK_COMMA parameter_declaration

   64 parameter_declaration: type_specifier parameter_declarator_opt

   65 parameter_declarator_opt: /* empty */
   66                         | TOK_IDENTIFIER array_dimensions_opt
   67                         | TOK_STAR TOK_IDENTIFIER array_dimensions_opt
   68                         | TOK_BITAND TOK_IDENTIFIER array_dimensions_opt
   69                         | parenthesized_parameter_declarator

   70 parenthesized_parameter_declarator: TOK_LPAREN TOK_STAR parameter_name_opt TOK_RPAREN TOK_LPAREN parameter_list_opt TOK_RPAREN
   71                                   | TOK_LPAREN TOK_STAR parameter_name_opt TOK_RPAREN array_dimensions
   72                                   | TOK_LPAREN TOK_BITAND parameter_name_opt TOK_RPAREN array_dimensions

   73 parameter_name_opt: /* empty */
   74                   | TOK_IDENTIFIER

   75 declaration: type_specifier init_declarator_list TOK_SEMI
   76            | parenthesized_declarator TOK_SEMI

   77 parenthesized_declarator: simple_type TOK_LPAREN TOK_STAR TOK_IDENTIFIER TOK_RPAREN TOK_LPAREN parameter_list_opt TOK_RPAREN initializer_opt
   78                         | simple_type TOK_LPAREN TOK_STAR TOK_IDENTIFIER TOK_RPAREN array_dimensions initializer_opt

   79 init_declarator_list: init_declarator
   80                     | init_declarator_list TOK_COMMA init_declarator

   81 init_declarator: qualified_name array_dimensions_opt initializer_opt
   82                | TOK_STAR qualified_name array_dimensions_opt initializer_opt
   83                | TOK_BITAND qualified_name array_dimensions_opt initializer_opt

   84 array_dimensions_opt: /* empty */
   85                     | array_dimensions

   86 array_dimensions: TOK_LBRACKET expression_opt TOK_RBRACKET
   87                 | array_dimensions TOK_LBRACKET expression_opt TOK_RBRACKET

   88 initializer_opt: /* empty */
   89                | TOK_ASSIGN initializer
   90                | braced_init_list

   91 initializer: assignment_expression
   92            | braced_init_list

   93 braced_init_list: TOK_LBRACE initializer_list_opt TOK_RBRACE

   94 initializer_list_opt: /* empty */
   95                     | initializer_list
   96                     | initializer_list TOK_COMMA

   97 initializer_list: initializer
   98                 | initializer_list TOK_COMMA initializer

   99 local_declaration: local_declaration_body TOK_SEMI
  100                  | TOK_STATIC local_declaration_body TOK_SEMI

  101 local_declaration_body: parenthesized_declarator
  102                       | simple_type init_declarator_list
  103                       | TOK_STRUCT TOK_IDENTIFIER init_declarator_list
  104                       | TOK_IDENTIFIER named_type_declarator_list

  105 named_type_declarator_list: named_type_declarator
  106                           | named_type_declarator_list TOK_COMMA named_type_declarator

  107 named_type_declarator: TOK_IDENTIFIER array_dimensions_opt initializer_opt
  108                      | TOK_IDENTIFIER TOK_LPAREN argument_list_opt TOK_RPAREN
  109                      | TOK_STAR TOK_IDENTIFIER array_dimensions_opt initializer_opt
  110                      | TOK_BITAND TOK_IDENTIFIER array_dimensions_opt initializer_opt

  111 compound_statement: TOK_LBRACE block_items_opt TOK_RBRACE

  112 block_items_opt: /* empty */
  113                | block_items_opt block_item

  114 block_item: local_declaration
  115           | statement
  116           | error TOK_SEMI

  117 statement: compound_statement
  118          | expression_statement
  119          | selection_statement
  120          | iteration_statement
  121          | jump_statement
  122          | labeled_statement

  123 expression_statement: expression_opt TOK_SEMI

  124 selection_statement: TOK_IF TOK_LPAREN expression TOK_RPAREN statement
  125                    | TOK_IF TOK_LPAREN expression TOK_RPAREN statement TOK_ELSE statement
  126                    | TOK_SWITCH TOK_LPAREN expression TOK_RPAREN statement

  127 iteration_statement: TOK_WHILE TOK_LPAREN expression TOK_RPAREN statement
  128                    | TOK_DO statement TOK_WHILE TOK_LPAREN expression TOK_RPAREN TOK_SEMI
  129                    | TOK_FOR TOK_LPAREN for_initializer TOK_SEMI expression_opt TOK_SEMI expression_opt TOK_RPAREN statement

  130 for_initializer: /* empty */
  131                | expression
  132                | local_declaration_body

  133 jump_statement: TOK_RETURN expression_opt TOK_SEMI
  134               | TOK_BREAK TOK_SEMI
  135               | TOK_CONTINUE TOK_SEMI
  136               | TOK_GOTO TOK_IDENTIFIER TOK_SEMI

  137 labeled_statement: TOK_IDENTIFIER TOK_COLON statement
  138                  | TOK_CASE conditional_expression TOK_COLON statement
  139                  | TOK_DEFAULT TOK_COLON statement

  140 expression_opt: /* empty */
  141               | expression

  142 expression: assignment_expression

  143 assignment_expression: conditional_expression
  144                      | unary_expression assignment_operator assignment_expression

  145 assignment_operator: TOK_ASSIGN
  146                    | TOK_PLUS_ASSIGN
  147                    | TOK_MINUS_ASSIGN
  148                    | TOK_STAR_ASSIGN
  149                    | TOK_SLASH_ASSIGN
  150                    | TOK_PERCENT_ASSIGN

  151 conditional_expression: logical_or_expression
  152                       | logical_or_expression TOK_QUESTION expression TOK_COLON conditional_expression

  153 logical_or_expression: logical_and_expression
  154                      | logical_or_expression TOK_OR logical_and_expression

  155 logical_and_expression: bitwise_or_expression
  156                       | logical_and_expression TOK_AND bitwise_or_expression

  157 bitwise_or_expression: bitwise_xor_expression
  158                      | bitwise_or_expression TOK_BITOR bitwise_xor_expression

  159 bitwise_xor_expression: bitwise_and_expression
  160                       | bitwise_xor_expression TOK_BITXOR bitwise_and_expression

  161 bitwise_and_expression: equality_expression
  162                       | bitwise_and_expression TOK_BITAND equality_expression

  163 equality_expression: relational_expression
  164                    | equality_expression TOK_EQ relational_expression
  165                    | equality_expression TOK_NEQ relational_expression

  166 relational_expression: shift_expression
  167                      | relational_expression TOK_LT shift_expression
  168                      | relational_expression TOK_GT shift_expression
  169                      | relational_expression TOK_LE shift_expression
  170                      | relational_expression TOK_GE shift_expression

  171 shift_expression: additive_expression
  172                 | shift_expression TOK_SHL additive_expression
  173                 | shift_expression TOK_SHR additive_expression

  174 additive_expression: multiplicative_expression
  175                    | additive_expression TOK_PLUS multiplicative_expression
  176                    | additive_expression TOK_MINUS multiplicative_expression

  177 multiplicative_expression: unary_expression
  178                          | multiplicative_expression TOK_STAR unary_expression
  179                          | multiplicative_expression TOK_SLASH unary_expression
  180                          | multiplicative_expression TOK_PERCENT unary_expression

  181 unary_expression: postfix_expression
  182                 | TOK_INC unary_expression
  183                 | TOK_DEC unary_expression
  184                 | TOK_PLUS unary_expression
  185                 | TOK_MINUS unary_expression
  186                 | TOK_NOT unary_expression
  187                 | TOK_BITNOT unary_expression
  188                 | TOK_STAR unary_expression
  189                 | TOK_BITAND unary_expression
  190                 | TOK_NEW allocation_type allocation_suffix_opt
  191                 | TOK_DELETE unary_expression
  192                 | TOK_DELETE TOK_LBRACKET TOK_RBRACKET delete_operand

  193 delete_operand: TOK_IDENTIFIER
  194               | TOK_THIS
  195               | delete_operand TOK_DOT TOK_IDENTIFIER
  196               | delete_operand TOK_ARROW TOK_IDENTIFIER
  197               | delete_operand TOK_LBRACKET expression TOK_RBRACKET

  198 allocation_type: simple_type
  199                | TOK_IDENTIFIER
  200                | TOK_STRUCT TOK_IDENTIFIER

  201 allocation_suffix_opt: /* empty */
  202                      | TOK_LPAREN argument_list_opt TOK_RPAREN
  203                      | braced_init_list
  204                      | allocation_dimensions
  205                      | allocation_dimensions braced_init_list

  206 allocation_dimensions: TOK_LBRACKET expression TOK_RBRACKET
  207                      | allocation_dimensions TOK_LBRACKET expression TOK_RBRACKET

  208 postfix_expression: primary_expression
  209                   | postfix_expression TOK_LBRACKET expression TOK_RBRACKET
  210                   | postfix_expression TOK_LPAREN argument_list_opt TOK_RPAREN
  211                   | postfix_expression TOK_DOT TOK_IDENTIFIER
  212                   | postfix_expression TOK_ARROW TOK_IDENTIFIER
  213                   | postfix_expression TOK_INC
  214                   | postfix_expression TOK_DEC

  215 argument_list_opt: /* empty */
  216                  | argument_list

  217 argument_list: assignment_expression
  218              | argument_list TOK_COMMA assignment_expression

  219 primary_expression: TOK_IDENTIFIER
  220                   | TOK_INT_LITERAL
  221                   | TOK_FLOAT_LITERAL
  222                   | TOK_CHAR_LITERAL
  223                   | TOK_STRING_LITERAL
  224                   | TOK_TRUE
  225                   | TOK_FALSE
  226                   | TOK_NULL
  227                   | TOK_THIS
  228                   | TOK_LPAREN expression TOK_RPAREN
  229                   | lambda_expression

  230 lambda_expression: TOK_LBRACKET TOK_RBRACKET TOK_LPAREN parameter_list_opt TOK_RPAREN compound_statement
  231                  | TOK_LBRACKET capture_default TOK_RBRACKET TOK_LPAREN parameter_list_opt TOK_RPAREN compound_statement
  232                  | TOK_LBRACKET capture_list TOK_RBRACKET TOK_LPAREN parameter_list_opt TOK_RPAREN compound_statement

  233 capture_default: TOK_ASSIGN
  234                | TOK_BITAND

  235 capture_list: capture
  236             | capture_list TOK_COMMA capture

  237 capture: TOK_IDENTIFIER
  238        | TOK_BITAND TOK_IDENTIFIER
  239        | TOK_THIS


