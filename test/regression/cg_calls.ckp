// regression: calls. more than 6 int args (stack args), more than 8 floating args,
// mixed int and floating args, char and bool args, recursion, mutual recursion,
// variadic printf with doubles and stack args, calls nested in arguments

int sum8(int a, int b, int c, int d, int e, int f, int g, int h) {
    return a + 2 * b + 3 * c + 4 * d + 5 * e + 6 * f + 7 * g + 8 * h;
}

double sum10(double a, double b, double c, double d, double e, double f, double g, double h,
             double i, double j) {
    return a + b * 2.0 + c * 3.0 + d * 4.0 + e * 5.0 + f * 6.0 + g * 7.0 + h * 8.0 + i * 9.0 + j * 10.0;
}

double mixed(int a, double b, char c, float d, bool e, int f, double g, int h, int i, int j, float k) {
    double r = a + b + c + d + f + g + h + i + j + k;
    if (e) r = r + 1000.0;
    return r;
}

int fact(int n) {
    if (n <= 1) return 1;
    return n * fact(n - 1);
}

int fib(int n) {
    if (n < 2) return n;
    return fib(n - 1) + fib(n - 2);
}

bool isEven(int n);

bool isOdd(int n) {
    if (n == 0) return false;
    return isEven(n - 1);
}

bool isEven(int n) {
    if (n == 0) return true;
    return isOdd(n - 1);
}

char nextChar(char c) { return c + 1; }

float half(float x) { return x / 2.0; }

void show(int x) { printf("show %d\n", x); }

int countdown(int n, int acc) {
    if (n == 0) return acc;
    return countdown(n - 1, acc + n);
}

int main() {
    printf("sum8 %d\n", sum8(1, 2, 3, 4, 5, 6, 7, 8));
    printf("sum8 neg %d\n", sum8(-1, -2, -3, -4, -5, -6, -7, -8));
    printf("sum10 %.3f\n", sum10(1.5, 2.5, 3.5, 4.5, 5.5, 6.5, 7.5, 8.5, 9.5, 10.5));
    printf("mixed %.3f\n", mixed(1, 2.5, 'A', 0.25, true, 6, 7.75, 8, 9, 10, 1.5));
    printf("mixed off %.3f\n", mixed(-1, -2.5, 'a', -0.25, false, -6, -7.75, -8, -9, -10, -1.5));
    printf("fact %d fib %d\n", fact(10), fib(15));
    printf("even %d odd %d even %d\n", isEven(10), isOdd(7), isEven(7));
    printf("char %c\n", nextChar('y'));
    double h = half(5.0);
    printf("half %.4f\n", h);
    show(42);
    printf("many %d %d %d %d %d %d %d %.2f %.2f %c\n", 1, 2, 3, 4, 5, 6, 7, 8.5, 9.25, 'z');
    printf("nested %d\n", sum8(fact(3), fib(5), 1, 2, 3, 4, sum8(1, 1, 1, 1, 1, 1, 1, 1), 5));
    printf("countdown %d\n", countdown(100, 0));
    return 0;
}
