// regression: constant propagation edge cases. a variable constant until a loop changes it on a
// late iteration, a switch on a propagated constant, a constant assigned inside a loop that runs
// zero times, float to int conversions and char wraparound in constant expressions, and a
// variable assigned the same constant on every path through a switch

int main() {
    //constant before the loop, changed on the 8th iteration: not a constant after it
    int mode = 1;
    int sum = 0;
    for (int i = 0; i < 10; i++) {
        sum += mode;
        if (i == 7) mode = 5;
    }
    printf("loop %d %d\n", sum, mode);

    //a switch on a constant picks one case at compile time
    int choice = 2;
    int picked = 0;
    switch (choice) {
    case 1:
        picked = 10;
        break;
    case 2:
        picked = 20;
    case 3:
        picked += 5;
        break;
    default:
        picked = -1;
    }
    printf("switch %d\n", picked);

    //the loop never runs, so v keeps 4
    int v = 4;
    for (int i = 0; i < 0; i++) v = 9;
    printf("zero trip %d\n", v);

    //the same value on every path
    int same = 0;
    int key = sum % 3;
    switch (key) {
    case 0:
        same = 7;
        break;
    case 1:
        same = 7;
        break;
    default:
        same = 7;
    }
    printf("same %d\n", same);

    //conversions and wraparound in constant expressions
    double big = 1e9;
    int asInt = big;
    float third = 1.0 / 3.0;
    double back = third;
    char c = 100;
    c = c + c;
    int negDiv = -7;
    int q = negDiv / 2;
    int r = negDiv % 2;
    printf("convert %d %.9f %d %d %d\n", asInt, back, c, q, r);
    return 0;
}

// -O1 and up: the switch on a constant is gone, "same" and the conversions are constants.
// picked (25) and the zero-trip v (4) need branches decided while propagating: -O1's dense
// propagation runs before simplify_cfg removes the dead paths, sccp at -O2 sees them as dead
// IR-LABEL: define i32 @main
// IR-GE1-NOT: switch i32 2
// IR-GE2: call i32 (ptr, ...) @printf(ptr %{{[A-Za-z0-9_.]+}}, i32 25)
// IR-GE2: call i32 (ptr, ...) @printf(ptr %{{[A-Za-z0-9_.]+}}, i32 4)
// IR-GE1: call i32 (ptr, ...) @printf(ptr %{{[A-Za-z0-9_.]+}}, i32 7)
// IR-GE1: call i32 (ptr, ...) @printf(ptr %{{[A-Za-z0-9_.]+}}, i32 1000000000, double {{0x[0-9A-F]+}}, i32 -56, i32 -3, i32 -1)
