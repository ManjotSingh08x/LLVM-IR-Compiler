// regression: mem2reg. scalar locals become ssa values with phis at the joins; an array, a struct
// and a local whose address is passed to a call stay in memory. phis are placed only where the
// variable is live, and a variable read before it is written reads zero

struct Point {
    int x;
    int y;
};

void addOne(int *p) { *p = *p + 1; }

int scalars(int n) {
    int a = 0;
    int b = 1;
    for (int i = 0; i < n; i++) {
        int t = a + b;
        a = b;
        b = t;
    }
    return a;
}

int mixed(int n) {
    int arr[4];
    Point p;
    int escaped = n;
    addOne(&escaped);
    arr[0] = escaped;
    p.x = arr[0] * 2;
    p.y = n;
    int plain = p.x + p.y;
    if (n > 3) plain = plain * 10;
    return plain;
}

int deadAfterJoin(int n) {
    int unused = 5;
    if (n > 0) {
        unused = 6;
    }
    int used = n * 2;
    return used;
}

int main() {
    printf("fib %d %d %d\n", scalars(0), scalars(1), scalars(20));
    printf("mixed %d %d\n", mixed(2), mixed(5));
    printf("dead %d\n", deadAfterJoin(4));
    return 0;
}

// -O2 and up: the fibonacci locals are phis in a function with no scalar slots
// IR-LABEL: define i32 @{{[A-Za-z0-9_]*}}scalars
// IR-GE2-NOT: alloca
// IR-GE2: phi i32
// IR-LABEL: define i32 @{{[A-Za-z0-9_]*}}mixed
// the array, the struct and the escaped local keep their slots
// IR-GE2-DAG: alloca [4 x i32]
// IR-GE2-DAG: alloca %struct.Point
// IR-GE2-DAG: %escaped = alloca i32
// IR-LABEL: define i32 @{{[A-Za-z0-9_]*}}deadAfterJoin
// "unused" is never read: no phi for it
// IR-GE2-NOT: phi
// IR-LABEL: define i32 @main
