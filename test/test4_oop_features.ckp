// Tests: class and object; public/private/protected keywords
class Animal {
public:
    int age;

    // Tests: static member, defined outside the class below
    static int created;

    // Tests: constructor and destructor declarations
    Animal();
    Animal(int a);
    Animal(int a, int l);
    ~Animal();

    void setAge(int a) {
        this->age = a;
    }

protected:
    int legs;

private:
    int secretId;

    int hidden() {
        return secretId + legs;
    }
};

// Tests: inheritance
class Dog : public Animal {
public:
    bool loud;

    // Tests: constructor and destructor definitions
    Dog() {
        this->loud = false;
    }

    Dog(bool l) {
        this->loud = l;
    }

    ~Dog() {
        this->loud = false;
    }

    void bark() {
        this->loud = true;
    }
};

// Tests: inheritance; protected and private keywords
class Cat : protected Animal {
private:
    bool quiet;
};

// Tests: additional scope resolution operator; definition of a static member
int Animal::created = 0;

int main() {
    // Tests: class and object; dynamic memory allocation
    Animal *a = new Animal();
    a->setAge(3);
    delete a;

    // Tests: class and object; inheritance
    Dog d;
    d.bark();
    d.setAge(5);

    Cat c;
    return 0;
}

// Tests: inheritance without an access specifier, and from more than one base
class Trackable { public: int serial; };

class Tagged : Animal { public: int tag; };

class Registered : public Animal, public Trackable { public: int slot; };

// Tests: a structure that inherits
struct BaseRec { int first; };
struct DerivedRec : BaseRec { int second; };

// Tests: a class defined inside another class
class Outer {
public:
    struct Inner { int value; };
    class Nested { public: int depth; };
    Inner   inner;
    Nested  nested;
};

// Tests: declaring an object with constructor arguments inside a function
int buildObjects() {
    Animal plain;
    Animal withOne(3);
    Animal withTwo(3, 4);
    Tagged tagged;
    Registered registered;
    Outer outer;

    outer.inner.value = 1;
    outer.nested.depth = 2;
    return withOne.age + withTwo.age + tagged.tag + registered.slot;
}
