// regression: licm. invariant arithmetic moves to the preheader; a value invariant in both of two
// nested loops moves to the outer preheader; a division that would trap is hoisted only when it runs
// on every iteration of a loop that runs at all; a division under a condition stays. the divisor
// comes from stdin (test/regression/inputs): 0 7 5

int invariantMul(int n, int a, int b) {
    int s = 0;
    for (int i = 0; i < n; i++) s += a * b + i;
    return s;
}

int nested(int n, int a, int b) {
    int s = 0;
    for (int i = 0; i < n; i++)
        for (int j = 0; j < n; j++) s += (a + b) * 3 + j;
    return s;
}

int zeroTrip(int n, int d) {
    int s = 0;
    for (int i = 0; i < n; i++) s += 100 / d;  //d is 0 when n is 0: must not run
    return s;
}

int guarded(int n, int d) {
    int s = 0;
    for (int i = 0; i < n; i++) {
        if (d != 0) s += 100 / d;  //only under the test
        s++;
    }
    return s;
}

int main() {
    int zero;
    int seven;
    int five;
    scanf("%d %d %d", &zero, &seven, &five);
    printf("mul %d %d\n", invariantMul(0, 3, 4), invariantMul(10, 3, 4));
    printf("nested %d\n", nested(5, seven, five));
    printf("zero %d %d\n", zeroTrip(0, zero), zeroTrip(4, seven));
    printf("guarded %d %d\n", guarded(6, zero), guarded(6, five));
    return 0;
}

// -O2 and up: the multiply is computed before the loop and not inside it
// IR-LABEL: define i32 @{{[A-Za-z0-9_]*}}invariantMul
// IR-GE2: mul i32 %a, %b
// IR-GE2: phi i32
// IR-GE2-NOT: mul i32
// IR-LABEL: define i32 @{{[A-Za-z0-9_]*}}nested
// the sum and the * 3 are invariant in both loops: they come before the first phi
// IR-GE2: add i32 %a, %b
// IR-GE2: phi i32
// IR-GE2-NOT: add i32 %a, %b
// IR-LABEL: define i32 @{{[A-Za-z0-9_]*}}zeroTrip
// the loop is rotated, so the division runs on every iteration of a loop that runs: hoisted
// IR-GE2: sdiv i32 100, %d
// IR-GE2: phi i32
// IR-GE2-NOT: sdiv
// IR-LABEL: define i32 @{{[A-Za-z0-9_]*}}guarded
// under a test inside the loop: stays after the loop's phi
// IR-GE2: phi i32
// IR-GE2: sdiv i32 100, %d
// IR-LABEL: define i32 @main
