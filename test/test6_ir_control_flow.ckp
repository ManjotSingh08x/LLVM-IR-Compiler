int sign(int n) {
    if (n < 0) {
        return -1;
    } else if (n == 0) {
        return 0;
    } else {
        return 1;
    }
}

int grade(int score) {
    int result = 0;
    switch (score) {
        case 1:
        case 2:
            result = 10;
            break;
        case 3:
            result = 30;
            break;
        default:
            result = -1;
    }
    return result;
}

int factorial(int n) {
    if (n <= 1) return 1;
    return n * factorial(n - 1);
}

int main() {
    printf("%d %d %d\n", sign(-4), sign(0), sign(9));
    printf("%d %d %d\n", grade(2), grade(3), grade(7));
    printf("%d\n", factorial(5));

    int odd = 0;
    for (int i = 0; i < 10; i++) {
        if (i % 2 == 0) continue;
        if (i > 7) break;
        odd += i;
    }

    int n = 0;
    while (n < 5) {
        n++;
    }
    int m = 0;
    do {
        m += 2;
    } while (m < 7);

    int tries = 0;
retry:
    tries++;
    if (tries < 3) goto retry;

    printf("%d %d %d %d\n", odd, n, m, tries);
    return 0;
}
