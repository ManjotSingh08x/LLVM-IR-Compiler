state 0

    0 $accept: . translation_unit $end

    $default  reduce using rule 1 (translation_unit)

    translation_unit  go to state 1


state 1

    0 $accept: translation_unit . $end
    2 translation_unit: translation_unit . external_item

    $end            shift, and go to state 2
    error           shift, and go to state 3
    TOK_IDENTIFIER  shift, and go to state 4
    TOK_INT         shift, and go to state 5
    TOK_CHAR        shift, and go to state 6
    TOK_FLOAT       shift, and go to state 7
    TOK_DOUBLE      shift, and go to state 8
    TOK_VOID        shift, and go to state 9
    TOK_BOOL        shift, and go to state 10
    TOK_AUTO        shift, and go to state 11
    TOK_STRUCT      shift, and go to state 12
    TOK_CLASS       shift, and go to state 13
    TOK_STATIC      shift, and go to state 14

    external_item                        go to state 15
    static_item                          go to state 16
    qualified_special_member_definition  go to state 17
    record_definition                    go to state 18
    class_definition                     go to state 19
    simple_type                          go to state 20
    type_specifier                       go to state 21
    function_definition                  go to state 22
    function_declaration                 go to state 23
    declaration                          go to state 24
    parenthesized_declarator             go to state 25


state 2

