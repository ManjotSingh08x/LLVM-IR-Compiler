// Tests: plain enum (unsupported)
enum Colour { RED, GREEN };

// Tests: auto return type (unsupported)
auto twice(int x) { return 2 * x; }

// Tests: lambda with an auto parameter (unsupported)
int next() { auto f = [](auto x) { return x + 1; }; return f(2); }

// Tests: variable-length array (unsupported)
int first(int n) { int values[n]; values[0] = n; return values[0]; }
