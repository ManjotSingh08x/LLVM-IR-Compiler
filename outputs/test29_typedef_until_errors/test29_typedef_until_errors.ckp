// Semantic errors for typedef and until. Every line marked ERROR is reported.

typedef int Integer;

// Tests: a typedef name cannot be declared twice
typedef char Integer;                 // ERROR redefinition of 'Integer'

// Tests: the aliased type must exist
typedef Missing Unknown;              // ERROR unknown type name 'Missing'

// Tests: auto is not a type a typedef can name
typedef auto Deduced;                 // ERROR 'auto' cannot be used in a typedef

// Tests: a typedef of void is allowed, a variable of that type is not
typedef void Nothing;
Nothing nothing;                      // ERROR 'nothing' cannot have type void

class Box {
public:
    typedef int Size;
    Size size;
};

// Tests: struct X names only a record, never a typedef
struct Integer wrong;                 // ERROR unknown type name 'Integer'

int main() {
    // Tests: a typedef name is a type, not a value
    int a = Integer;                  // ERROR 'Integer' is a type, not a value

    // Tests: a member typedef is not a member value
    Box box;
    int b = box.Size;                 // ERROR 'Size' is a type, not a member value

    // Tests: a local typedef is gone after its block
    {
        typedef int Inner;
        Inner fine = 1;
    }
    Inner gone = 2;                   // ERROR unknown type name 'Inner'

    // Tests: until and do-until need a condition that converts to bool
    until (box) a++;                  // ERROR an until condition
    do { a++; } until (box);          // ERROR a do-until condition

    // Tests: break and continue are fine in an until loop, not outside one
    until (a > 5) { if (a == 3) break; a++; continue; }
    break;                            // ERROR break outside a loop
    return 0;
}
