// Tests: structure
struct Point {
    int x;
    int y;
};

// Tests: array passed to a function
int sum(int *data, int n) {
    int total = 0;
    for (int i = 0; i < n; i++) total += data[i];
    return total;
}

int main() {
    int values[5] = {3, 1, 4, 1, 5};

    // Tests: pointer arithmetic
    int *p = values;
    p += 2;
    int third = *p;
    int last = *(values + 4);

    // Tests: index written before the array
    int second = 1[values];

    // Tests: two-dimensional array
    int grid[2][2] = {{1, 2}, {3, 4}};
    grid[1][0] = 30;

    // Tests: structure through a pointer
    Point pt = {1, 2};
    Point *pp = &pt;
    pp->x = 10;

    printf("%d %d %d %d %d %d %d\n", sum(values, 5), third, last, second, grid[1][0], pt.x, pt.y);
    return 0;
}
