// stress: control flow. switch with fall-through and default, nested loops with break and
// continue at both levels, goto loops, do and until loops, short-circuit conditions with side
// effects inside loop conditions, early returns from inside nested loops, a state machine

int evaluations = 0;

bool check(int v, int limit) {
    evaluations++;
    return v < limit;
}

int dayKind(int day) {
    int kind = 0;
    switch (day) {
    case 0:
    case 6:
        kind = 2;
        break;
    case 3:
        kind = 5;
    case 4:
        kind = kind + 1;
        break;
    default:
        kind = 1;
    }
    return kind;
}

int findPair(int target) {
    for (int i = 0; i < 20; i++) {
        for (int j = i; j < 20; j++) {
            if (i * j == target) return i * 100 + j;
            if (i * j > target) break;
        }
    }
    return -1;
}

int skipping(int n) {
    int total = 0;
    for (int i = 0; i < n; i++) {
        if (i % 2 == 0) continue;
        for (int j = 0; j < i; j++) {
            if (j % 3 == 0) continue;
            if (j > 7) break;
            total += j;
        }
        if (total > 500) break;
    }
    return total;
}

int gotoSum(int n) {
    int i = 0;
    int s = 0;
loop:
    if (i >= n) goto out;
    s += i;
    i++;
    if (s > 1000) goto out;
    goto loop;
out:
    return s * 10 + i;
}

int machine(int steps) {
    int state = 0;
    int out = 0;
    for (int i = 0; i < steps; i++) {
        switch (state) {
        case 0:
            out += 1;
            state = i % 3 == 0 ? 1 : 2;
            break;
        case 1:
            out *= 2;
            state = 2;
            break;
        case 2:
            out -= 3;
            state = out % 2 == 0 ? 0 : 1;
            break;
        }
        if (out > 100000) out = out % 977;
    }
    return out;
}

int main() {
    int kinds = 0;
    for (int d = 0; d < 8; d++) kinds = kinds * 10 + dayKind(d);
    printf("days %d\n", kinds);
    printf("pairs %d %d %d\n", findPair(42), findPair(97), findPair(0));
    printf("skip %d %d\n", skipping(10), skipping(100));
    printf("goto %d %d\n", gotoSum(10), gotoSum(1000));

    int a = 0;
    do {
        a += 3;
    } while (a < 20);
    int b = 100;
    until (b < 10) {
        b = b / 2 - 1;
    }
    printf("loops %d %d\n", a, b);

    evaluations = 0;
    int i = 0;
    int j = 0;
    while (check(i, 10) && check(j, 25)) {
        i++;
        j += 3;
    }
    int ors = 0;
    for (int k = 0; k < 10; k++) {
        if (check(k, 3) || check(20 - k, 15)) ors++;
    }
    printf("short %d %d %d evals %d\n", i, j, ors, evaluations);
    printf("machine %d %d\n", machine(10), machine(5000));
    return 0;
}
