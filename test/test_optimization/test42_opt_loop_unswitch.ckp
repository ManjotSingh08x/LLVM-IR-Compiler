// Tests: loop_unswitch decides a test that never changes in the loop once, before it (-O2 and up)
int total(int *data, int n, bool doubled) {
    int sum = 0;
    for (int i = 0; i < n; i++) {
        if (doubled) sum += data[i] * 2;
        else sum += data[i];
    }
    return sum;
}

int main() {
    int data[3] = {1, 2, 3};
    printf("%d %d\n", total(data, 3, true), total(data, 3, false));
    return 0;
}

// IR-O1-LABEL: define i32 @{{.*}}total
// IR-O1: for.body:
// IR-O1: br i1 %{{.*}}, label %if.then, label %if.else
// IR-GE2-LABEL: define i32 @{{.*}}total
// IR-GE2: br i1 %doubled, label %for.body, label %for.body.1
