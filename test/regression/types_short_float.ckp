// short and unsigned short: 16-bit loads and stores, wraparound, promotion to int, sign and zero
// extension into division, shifts, calls and double; and float literals with the f suffix, which
// stay float instead of widening to double. inputs come from stdin (test/regression/inputs) so no
// level can fold them: 32767 65535 -7 70000

short gs = -1234;
unsigned short gus = 65000;
short table[4] = {1, -2, 30000, -30000};
struct Packed { char c; short s; int i; };

short addShort(short a, short b) { return a + b; }
unsigned short addUShort(unsigned short a, unsigned short b) { return a + b; }
long mix(short s, unsigned short u) { return (long)s * 100000 + u; }
float scale(float x) { return x * 0.5f + 1.25f; }

int main() {
    int a, b, c, d;
    scanf("%d %d %d %d", &a, &b, &c, &d);
    short s = a;
    s = s + 1;
    unsigned short u = b;
    u = u + 1;
    short neg = c;
    printf("%d %d %d %d\n", s, u, neg / 2, neg % 3);
    printf("%d %d %d\n", neg >> 1, (unsigned short)neg >> 1, (unsigned short)b / 7);
    printf("%d %d %ld\n", addShort(a, a), addUShort(b, 3), mix(neg, b));
    printf("%d %d %d %d\n", gs, gus, table[2], table[3]);
    struct Packed p = {'a', (short)d, d};
    printf("%d %d %d %d\n", (int)sizeof(short), (int)sizeof(struct Packed), p.s, p.i);
    short sum = 0;
    for (short i = 0; i < 4; i++) sum += table[i];
    unsigned short fromDouble = 3.9;
    printf("%d %f %d %d\n", sum, (double)gs, fromDouble, gs < gus);
    float f = 1.1f;
    double widened = 1.1f;
    printf("%.10f %.10f %.10f %d\n", f, widened, scale(c), (int)(sizeof(1.5f) + sizeof(1.5)));
    return 0;
}

// IR: store i16
// IR: sext i16 {{.*}} to i32
// IR: zext i16 {{.*}} to i32
// IR: fmul float
