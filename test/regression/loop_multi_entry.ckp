// regression: loop canonical form. a loop entered from several blocks gets one preheader;
// a loop whose exit is also reached from outside gets a dedicated exit block; a loop with
// several back edges (continue in a while loop) gets one latch

int twoEntries(int n, int flag) {
    int i;
    if (flag > 0) {
        i = 10;
    } else {
        i = 20;
    }
    while (i < n) i = i + 3;
    return i;
}

int sharedExit(int n, int skip) {
    int i = 0;
    if (skip > 0) goto after;
    while (i < n) i = i + 2;
after:
    return i;
}

int manyLatches(int n) {
    int i = 0;
    int odd = 0;
    while (i < n) {
        i++;
        if (i % 2 == 1) {
            odd++;
            continue;
        }
        if (i > 100) continue;
    }
    return odd * 1000 + i;
}

int main() {
    printf("entries %d %d %d\n", twoEntries(30, 1), twoEntries(30, 0), twoEntries(5, 1));
    printf("exit %d %d\n", sharedExit(9, 0), sharedExit(9, 1));
    printf("latches %d %d\n", manyLatches(0), manyLatches(11));
    return 0;
}

// -O0 keeps the canonical blocks (from -O1 on, simplify_cfg bypasses them again)
// the two ways into the while loop meet in a new preheader
// IR-O0-LABEL: define {{.*}}twoEntries
// IR-O0: while.{{(cond|body)}}{{[.0-9]*}}.preheader:
// the loop's exit edge gets its own block, the goto keeps the old one
// IR-O0-LABEL: define {{.*}}sharedExit
// IR-O0: {{[A-Za-z0-9_.]+}}.loopexit:
// IR-O0-LABEL: define {{.*}}main
