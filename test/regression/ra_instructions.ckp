// regression: every kind of instruction isel emits, under register pressure (-O3), so each one's
// fixed registers meet live values: division and remainder (rax, rdx), shifts (cl), compares and
// selects (setcc, cmov), every cast, float compares (al, cl), fneg, char and bool arguments, more
// than six integer and eight float arguments (stack), a call through a pointer, a switch whose
// targets have phis (the copies on each edge), and phis that swap. the inputs (test/regression/inputs)
// are 17 5 3

typedef int (*Op)(int, int);

int addOp(int a, int b) { return a + b; }
int subOp(int a, int b) { return a - b; }

int manyArgs(int a, int b, int c, int d, int e, int f, int g, int h, char i, bool j) {
    return a - b + c * d - e + f * g - h + i + j;
}

double manyFloats(double a, double b, double c, double d, double e, double f, double g, double h,
                  double i, double j, float k) {
    return a + b * 2.0 - c + d * 3.0 - e + f - g * 0.5 + h + i - j + k;
}

int main() {
    int x;
    int y;
    int z;
    scanf("%d %d %d", &x, &y, &z);

    //division and shifts with many values live around them
    int keep1 = x * 3;
    int keep2 = y * 5;
    int keep3 = z * 7;
    int q = x / y;
    int r = x % y;
    int nq = -x / y;
    int nr = -x % z;
    int sl = x << z;
    int sr = -x >> 2;
    printf("divshift %d %d %d %d %d %d %d\n", q, r, nq, nr, sl, sr, keep1 + keep2 + keep3);

    //compares, selects, booleans
    bool lt = x < y;
    bool ge = x >= z;
    int pick = x > y ? keep1 : keep2;
    int pick2 = lt ? keep3 : keep1;
    printf("cmp %d %d %d %d %d\n", lt, ge, pick, pick2, keep1 - keep2);

    //casts of every kind
    char c = x + 100;
    int fromChar = c;
    double d = x;
    float f = d / 3.0;
    double back = f;
    int truncated = back * 7.0;
    bool asBool = x;
    double neg = -d;
    float fneg = -f;
    double negBack = fneg;
    printf("cast %d %.3f %.5f %d %d %.2f %.3f\n", fromChar, d, back, truncated, asBool, neg, negBack);

    //float compares
    double e = y * 1.5;
    bool feq = d == e;
    bool fne = d != e;
    bool flt = d < e;
    bool fge = d >= e;
    printf("fcmp %d %d %d %d\n", feq, fne, flt, fge);

    //arguments in registers and on the stack, a call through a pointer
    printf("args %d %.3f\n", manyArgs(x, y, z, keep1, keep2, keep3, q, r, c, lt),
           manyFloats(d, e, back, 1.5, 2.5, 3.5, 4.5, 5.5, 6.5, 7.5, f));
    Op op = addOp;
    if (x > 100) op = subOp;
    printf("pointer %d %d\n", op(x, y), op(keep1, keep3));

    //a switch whose case blocks start with phis, and phis that swap
    int a = 1;
    int b = 2;
    int total = 0;
    for (int i = 0; i < x; i++) {
        int t = a;
        a = b;
        b = t + i;
        switch (i % 4) {
        case 0:
            total = total + a;
            break;
        case 1:
            total = total - b;
            break;
        case 2:
            total = total * 2 % 1009;
            break;
        default:
            total = total + 1;
        }
    }
    printf("loop %d %d %d\n", a, b, total);
    return 0;
}
