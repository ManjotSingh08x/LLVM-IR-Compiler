// regression: induction variables and strength reduction. an array walked by index becomes a
// pointer that steps through it; i * 12 becomes a variable that grows by 12; loops counting down
// and by steps of 3; a two-dimensional row walk; the counter still ends the loop

int sumArray(int a[], int n) {
    int s = 0;
    for (int i = 0; i < n; i++) s += a[i];
    return s;
}

int scaled(int n) {
    int s = 0;
    for (int i = 0; i < n; i++) s += i * 12;
    return s;
}

int down(int a[], int n) {
    int s = 0;
    for (int i = n - 1; i >= 0; i--) s = s * 2 % 1000003 + a[i];
    return s;
}

int stride(int a[], int n) {
    int s = 0;
    for (int i = 0; i < n; i += 3) s += a[i] * (i + 1);
    return s;
}

int main() {
    int data[50];
    for (int i = 0; i < 50; i++) data[i] = i * 7 % 11 - 3;
    int grid[4][6];
    for (int r = 0; r < 4; r++)
        for (int c = 0; c < 6; c++) grid[r][c] = r * 10 + c;
    int rows = 0;
    for (int r = 0; r < 4; r++) rows = rows * 3 + sumArray(grid[r], 6);
    printf("sum %d %d %d\n", sumArray(data, 0), sumArray(data, 50), rows);
    printf("scaled %d %d\n", scaled(0), scaled(30));
    printf("down %d stride %d %d\n", down(data, 50), stride(data, 50), stride(data, 2));
    return 0;
}

// iv_strength_reduce runs at -O3 only (on -O2's linear allocator its new induction variables cost
// more than they save). -O2: not applied. -O3: the array is walked by a pointer phi, i * 12 is its
// own induction variable
// IR-LABEL: define i32 @{{[A-Za-z0-9_]*}}sumArray
// IR-O2-NOT: phi ptr
// IR-GE3: phi ptr
// IR-GE3: getelementptr i32, ptr %{{[A-Za-z0-9_.]+}}, i32 1
// IR-LABEL: define i32 @{{[A-Za-z0-9_]*}}scaled
// IR-GE3-NOT: mul i32
// IR-GE3: add i32 %{{[A-Za-z0-9_.]+}}, 12
// IR-LABEL: define i32 @{{[A-Za-z0-9_]*}}down
