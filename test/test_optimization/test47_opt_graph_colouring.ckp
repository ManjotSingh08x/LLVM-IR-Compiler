// Tests: graph colouring register allocation keeps many values in registers at once (-O3)
int mix(int a, int b, int c, int d) {
    int e = a + b;
    int f = c + d;
    int g = a * c;
    int h = b * d;
    return e * f + g * h;
}

int main() {
    printf("mix %d\n", mix(1, 2, 3, 4));
    return 0;
}

// ASM-O2-NOT: graph colouring
