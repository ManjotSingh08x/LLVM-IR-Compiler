// regression: sccp. constants that need a branch decided while propagating: the x != 1 loop where
// x stays 1 because the assignment that would change it never runs, a value constant on every
// executable path into a join, a switch on a value sccp proves constant, and a loop whose exit
// test is constant. the input (test/regression/inputs) is 6

int main() {
    int n;
    scanf("%d", &n);

    //x stays 1: "x != 1" is false on every executable path, so x = 2 never runs
    int x = 1;
    int count = 0;
    for (int i = 0; i < n; i++) {
        if (x != 1) x = 2;
        count++;
    }

    //y is 4 on both executable paths into the join; the third path is dead
    int y;
    int mode = 2;
    if (mode == 1) {
        y = 9;
    } else if (n > 3) {
        y = 4;
    } else {
        y = 4;
    }

    //a switch on a value only sccp knows is constant
    int key = mode * 3;
    int label = 0;
    switch (key) {
    case 6:
        label = 60;
        break;
    case 7:
        label = 70;
        break;
    default:
        label = -1;
    }

    //a loop whose test is constant false after the first round: runs once
    int rounds = 0;
    int keepGoing = 1;
    while (keepGoing == 1) {
        rounds++;
        keepGoing = 0;
    }

    printf("x %d count %d y %d label %d rounds %d\n", x, count, y, label, rounds);
    return 0;
}

// -O2 and up: x, y, label and rounds are constants where they are printed; count is not
// IR-LABEL: define i32 @main
// IR-GE2-NOT: switch
// IR-GE2: call i32 (ptr, ...) @printf(ptr %{{[A-Za-z0-9_.]+}}, i32 1, i32 %{{[A-Za-z0-9_.]+}}, i32 4, i32 60, i32 1)
