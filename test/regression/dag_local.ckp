// regression: local_dag (dragon 8.5). store-to-load forwarding, redundant loads, loads that a store
// through an alias or a call must kill, dead stores, algebraic identities, strength reduction, and
// the cases that must NOT be folded. the inputs come from stdin (test/regression/inputs) so the
// compiler cannot know them: 0 -1 3 0

int global = 5;

void setGlobal(int v) { global = v; }

int readTwice(int *p) { return *p + *p; }

int aliasing(int *p, int *q) {
    *p = 5;
    *q = 7;
    return *p;  //p and q may be the same address: this must be reloaded
}

int main() {
    int zero;
    int minusOne;
    int three;
    int never;
    scanf("%d %d %d %d", &zero, &minusOne, &three, &never);

    //forwarding and identities on a value the compiler does not know
    int x = three;
    int y = x + 0;
    int z = y * 1;
    int w = z * 8;
    int v = w - w;
    int u = (x & x) | 0;
    int t = x ^ 0;
    printf("ident %d %d %d %d %d %d\n", y, z, w, v, u, t);

    //a dead store: the first value is never read
    int dead = 100;
    dead = three * 2;
    printf("dead %d\n", dead);

    //redundant loads, and loads killed by a store through an alias and by a call
    int cell = 21;
    printf("twice %d alias %d %d\n", readTwice(&cell), aliasing(&cell, &cell), cell);
    int before = global;
    setGlobal(three);
    int after = global;
    printf("global %d %d\n", before, after);

    //floating identities that must not be applied
    double dz = zero;
    double nan = dz / dz;
    double negZero = -dz;
    printf("float %f %f %f\n", nan * 0.0, negZero + 0.0, negZero - 0.0);

    //never runs (never is 0), but must not be folded either: they trap on the machine
    if (never) {
        int intMin = -2147483647 - 1;
        int m1 = -1;
        int over = intMin / m1;
        int div0 = 7 / zero;
        int lit0 = 7 / 0;
        printf("never %d %d %d\n", over, div0, lit0);
    }
    return 0;
}

// -O1 and up: x * 8 is a shift, x - x and the identities are gone, the traps stay as they are
// IR-LABEL: define i32 @main
// IR-GE1: shl i32 %{{[A-Za-z0-9_.]+}}, 3
// IR-GE1-NOT: mul i32 %{{[A-Za-z0-9_.]+}}, 8
// IR-GE1: fdiv double
// IR-GE1: fmul double %{{[A-Za-z0-9_.]+}}, 0x0000000000000000
// IR-GE1: fadd double %{{[A-Za-z0-9_.]+}}, 0x0000000000000000
// IR-GE1: sdiv i32 -2147483648, -1
// IR-GE1: sdiv i32 7, %
// IR-GE1: sdiv i32 7, 0
