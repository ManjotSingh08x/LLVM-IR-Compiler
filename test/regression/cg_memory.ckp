// regression: memory. arrays, two-dimensional arrays, pointers and pointer arithmetic,
// arrays passed to functions, structs, arrays of structs, struct copies, heap arrays,
// char arrays, globals
// (passing a struct by value is not supported by the backend yet, so structs go by pointer)

struct Point {
    int x;
    int y;
};

struct Shape {
    Point corner;
    int sides;
    double scale;
};

int table[5] = {10, 20, 30, 40, 50};
int counter = 0;

int sumArray(int values[], int n) {
    int total = 0;
    for (int i = 0; i < n; i++) total += values[i];
    return total;
}

void fill(int *p, int n, int start) {
    for (int i = 0; i < n; i++) {
        *p = start + i;
        p = p + 1;
    }
}

int manhattan(Point *p) { return p->x + p->y; }

void movePoint(Point *p, int dx, int dy) {
    p->x = p->x + dx;
    p->y = p->y + dy;
}

int main() {
    int a[10];
    for (int i = 0; i < 10; i++) a[i] = i * i;
    printf("array %d %d %d sum %d\n", a[0], a[5], a[9], sumArray(a, 10));

    int grid[3][4];
    for (int r = 0; r < 3; r++)
        for (int c = 0; c < 4; c++) grid[r][c] = r * 10 + c;
    printf("grid %d %d %d\n", grid[0][0], grid[1][2], grid[2][3]);

    int buf[6];
    fill(buf, 6, 100);
    int *q = buf;
    q = q + 2;
    printf("ptr %d %d %d\n", *q, q[1], *(q + 3));

    Point p;
    p.x = 3;
    p.y = -7;
    movePoint(&p, 10, 20);
    printf("point %d %d %d\n", p.x, p.y, manhattan(&p));

    Point copy(p);
    copy.x = 0;
    printf("copy %d %d original %d %d\n", copy.x, copy.y, p.x, p.y);

    Point pts[4];
    for (int i = 0; i < 4; i++) {
        pts[i].x = i;
        pts[i].y = i * 3;
    }
    int total = 0;
    for (int i = 0; i < 4; i++) total += manhattan(&pts[i]);
    printf("points %d\n", total);

    Shape s;
    s.corner.x = 5;
    s.corner.y = 6;
    s.sides = 4;
    s.scale = 1.25;
    Shape t(s);
    t.corner.y = 60;
    printf("shape %d %d %d %.2f / %d\n", t.corner.x, t.corner.y, t.sides, t.scale, s.corner.y);

    int *heap = new int[8];
    for (int i = 0; i < 8; i++) heap[i] = 8 - i;
    printf("heap %d %d sum %d\n", heap[0], heap[7], sumArray(heap, 8));
    delete[] heap;

    char word[6] = "hello";
    word[0] = 'j';
    printf("word %s %c\n", word, word[4]);

    for (int i = 0; i < 5; i++) table[i] = table[i] + i;
    counter = counter + sumArray(table, 5);
    printf("global %d %d\n", table[4], counter);
    return 0;
}
